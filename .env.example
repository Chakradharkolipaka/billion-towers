# ── Hardhat / deploy ──
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_without_0x_prefix
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Official (may timeout on some WSL2/networks):
# ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Public fallback (default in hardhat.config.js):
ARBITRUM_SEPOLIA_RPC_URL=https://arbitrum-sepolia-rpc.publicnode.com
# Or use Alchemy/Infura (often more reliable):
# ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
ARBISCAN_API_KEY=your_arbiscan_api_key

# ── Frontend Web3 (Create React App — restart dev server after changes) ──
